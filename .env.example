# Copy to .env and fill in. .env is gitignored — your values never reach the repo.
# Quote any value that contains spaces.
LO_REPO="/path/to/your/repo"        # local checkout the agents clone from
LO_BASE="dev"                       # base branch
LO_TEAM="Your Team"                 # Linear team name
LO_PREFIX="XXX"                     # ticket id prefix, e.g. HYR2
LO_TIER1="Preferred Assignee"       # display name. ONLY these assignees are taken
LO_TIER2="Fallback Assignee"        # display name; leave empty if you have none
LO_ALLOW_UNASSIGNED="0"             # 1 = also take unassigned tickets. Off by
                                    # default: a name on a ticket is the signal
                                    # that it is meant for this loop
LO_ALLOW_BACKLOG="0"                # 1 = fall to Backlog when Todo is empty. Off
                                    # by default: an untriaged ticket is not a
                                    # queued one
LO_OWNER=""                         # short tag identifying THIS instance on the
                                    # forge, e.g. "wijnand". REQUIRED when two
                                    # orchestrators share one repo — the PR
                                    # marker becomes "🌙 lo:<owner>" and each
                                    # instance acts only on its own PRs. Empty
                                    # keeps the bare marker, which is correct
                                    # only for a single orchestrator
LO_RAM_PER_AGENT="2.5"              # GB budgeted per agent (claude + vite + chrome)
LO_MAX_AGENTS="0"                   # ceiling on concurrent agents. 0 = unlimited:
                                    # every tick spawns every slot free RAM
                                    # allows, so the loop ramps to full capacity
                                    # at once instead of one agent at a time
LO_SLOT_SCAN=""                     # agent slots to probe for liveness. Empty =
                                    # what total RAM allows, floor 8
LO_FEEDBACK_SINCE="2026-08-18T17:00:00Z"  # the day this loop began marking its own
                                    # comments. Comments older than this carry no
                                    # marker, so they would all read as human —
                                    # nothing before it is treated as feedback.
LO_FEEDBACK_LOGINS=""               # comma-separated GitHub logins whose comments
                                    # count as feedback, case insensitive. Empty
                                    # means every non-bot login counts.
LO_ADOPT_AUTHORS=""                 # comma-separated GitHub logins whose PRs the loop looks after:
                                    # one review pass when no person reviewed it, a base merge
                                    # on conflicts, a CI fix when red. Never promotes or merges.
LO_ADOPT_SINCE=""                   # ISO time; only PRs created after it are adopted.
LO_SLACK="0"                        # 1 = watch Slack: every channel, DM and group DM the loop's
                                    # Slack account is in. Needs a Claude Code MCP server named
                                    # "slack" (claude mcp add), logged in as that account.
LO_SLACK_TICKET_EMAILS=""           # comma-separated Slack account emails that may order a
                                    # ticket. Everybody gets an answer; empty means nobody
                                    # can order a ticket.
LO_SLACK_DATA_EMAILS=""             # comma-separated Slack account emails that may ask for
                                    # customer data, production included. Empty means nobody.
                                    # A secret (token, key, .env value) goes to nobody.
LO_SLACK_MERGE_EMAILS=""            # comma-separated Slack account emails that may order the loop
                                    # to merge a PR into the base branch, by number. Empty means
                                    # nobody, and the loop never merges without an order.
LO_SLACK_ADMIN_EMAILS=""            # comma-separated Slack account emails that may change the loop
                                    # itself (SKILL.md, the scripts) from a DM with it. The loop
                                    # commits and pushes the change. Empty means nobody. This file
                                    # and the safety rules cannot be changed from Slack.
LO_INBOX_EMAIL=""                   # optional: one Hyre mailbox to watch. Empty = off. The loop
                                    # sends a Slack DM about each new email, meeting and call
                                    # that matters. Needs a Claude Code MCP server named "hyre"
                                    # and LO_SLACK=1.
LO_INBOX_USER_ID=""                 # that person's Hyre user id, for meetings and calls
LO_INBOX_SLACK_USER=""              # the Slack user id that gets the DM
LO_SWEEP="0"                        # 1 = once an hour the loop checks mail, messages and the
                                    # calendar with whatever tools the session has (Hyre, Gmail,
                                    # Outlook...). The gate reads none of them: it only says
                                    # SWEEP-DUE, and wakes for it when nothing else did.
LO_SWEEP_EVERY="3600"               # seconds between sweeps

# lo-usage.sh: estimated plan usage and the cost ledger. USD at API list price.
LO_BUDGET_WEEK="7000"               # what counts as 100% of the plan's week (~100% weekly usage)
LO_USAGE_WEEK_RESET=""              # when the week resets, from /usage, e.g. "mon 09:00"
LO_WEEKLY_CHANNEL=""                # Slack channel id for the weekly report after each reset; empty = off
LO_INTERCOM_CHANNEL=""              # Slack channel where a bot posts each new Intercom conversation (2t)
LO_INTERCOM_DISCUSSION=""           # Slack channel where the loop opens one research thread per conversation; empty = off
                                    # (local time). Empty = the last 7 days

# watch-remote.sh: watching a loop that runs on a Linux server, from a Mac.
LO_REMOTE_HOST=""                   # ssh host of the server, e.g. an alias in ~/.ssh/config
LO_REMOTE_VNC_PASSWORD_FILE=""      # Mac file holding the server's VNC password; empty skips the browser view
LO_REMOTE_VNC_LOCAL_PORT="5901"     # local end of the VNC tunnel
LO_REMOTE_TERMINAL=""                # Linux only: terminal command, e.g. "kitty" or "gnome-terminal --"; empty = auto
LO_SLACK_PROD_EMAILS=""           # Slack emails whose explicit order may cover a merge into the default branch or a production write
LO_PERMISSIONS=""                   # shared permissions file; empty = <LO_REPO>/.agents/permissions.md. When it exists it replaces the LO_SLACK_*_EMAILS lists. Read from origin/LO_BASE, never the working tree
